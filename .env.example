# Public project token from PostHog → Project settings.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=phc_your_project_token

# Use https://us.i.posthog.com for a project in the US region.
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# Numeric tag ID from Yandex Metrica.
NEXT_PUBLIC_YANDEX_METRICA_ID=123456789
